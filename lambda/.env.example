# Database mode: 'sqlite' for local, 'dynamodb' for cloud
DB_MODE=sqlite

# JWT Secret (required, at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In AWS, Terraform generates it and stores it in Secrets Manager.
JWT_SECRET=

# Server port (local development only)
PORT=3001

# AWS DynamoDB table names (cloud mode only)
USERS_TABLE=client-timesheet-app-users
CLIENTS_TABLE=client-timesheet-app-clients
WORK_ENTRIES_TABLE=client-timesheet-app-work-entries

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
